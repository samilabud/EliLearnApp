{
  "name": "elilearn-animaladventures-app",
  "version": "4.0.1",
  "description": "Animal Adventures - An educational app for learning about animals",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write .",
    "clean": "expo r -c",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "preview-build-eas:android": "eas build --platform android --profile preview",
    "bump:patch": "node scripts/bump-version.js --type patch",
    "bump:minor": "node scripts/bump-version.js --type minor",
    "bump:major": "node scripts/bump-version.js --type major",
    "bump:set": "node scripts/bump-version.js --set",
    "bump:dry-run": "node scripts/bump-version.js --dry-run",
    "production-build-eas:android": "node scripts/bump-version.js --type patch && eas build --platform android --profile production --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/bangers": "^0.4.0",
    "@react-navigation/drawer": "^6.7.2",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "expo": "53.0.22",
    "expo-av": "~15.1.7",
    "expo-font": "~13.3.2",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.17",
    "lottie-react-native": "7.2.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0",
    "styled-components": "^5.3.11",
    "expo-audio": "~0.4.9"
  },
  "devDependencies": {
    "expo-dev-client": "~5.2.4",
    "@babel/core": "^7.28.3",
    "@babel/eslint-parser": "^7.28.0",
    "@react-native-community/cli": "^20.0.1",
    "@react-native-community/eslint-config": "^3.2.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-native": "^4.1.0",
    "prettier": "^3.6.2"
  },
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "react-native",
    "expo",
    "education",
    "animals",
    "learning",
    "kids"
  ],
  "author": "EliLearn Apps",
  "license": "MIT"
}